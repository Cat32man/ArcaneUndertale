# Godot 4 generated cache (rebuilt automatically when the project opens)
.godot/

# editor / OS noise
*.tmp
.DS_Store
Thumbs.db

# local tooling
.claude/

# installers and archives - never commit these (GitHub rejects files over 100 MB)
*.exe
*.msi
*.zip
*.7z

# ...except the zipped Web build that the Pages workflow deploys (tools/publish_web.ps1 updates it)
!/arcaneundertale (1).zip

# the raw Web export folder - only its zip is committed
build/

# an earlier Web export that was written straight into the project folder (the preset now uses build/web)
/Arcane Undertale.*
